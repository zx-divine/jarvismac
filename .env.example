# Documentation only. The application deliberately does not load .env files.
# Enter credentials in Settings; they are protected with Windows DPAPI.
# Chat API and audio API credentials are separate. No real secrets belong here.
# OPENAI_API_KEY=enter-in-settings
# ANTHROPIC_API_KEY=enter-in-settings
# Gemini reads this environment variable; .env files are not auto-loaded.
GEMINI_API_KEY=
